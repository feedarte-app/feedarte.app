{
  "name": "feedarte",
  "version": "1.0.0",
  "scripts": {
    "dev:api": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
