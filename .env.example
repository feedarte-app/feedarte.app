# Domain pointed at the server (A-record). Caddy issues the HTTPS certificate automatically.
DOMAIN=feeds.example.com
# Public base URL used in output feeds and image links (no trailing slash)
PUBLIC_URL=https://feeds.example.com

# Database password — generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# First admin account (created on first start if it does not exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Worker tuning: parallel jobs per worker, parallel image renders inside a job
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=6

# Max source feed size, MB
MAX_FEED_MB=300
BACKUP_KEEP_DAYS=14
