{$DOMAIN} {
	encode zstd gzip
	# rendered images & output feeds are large/static — give them generous timeouts
	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 5s
		# during a deploy the app restarts for a few seconds: hold requests instead of answering 503
		lb_try_duration 45s
		lb_try_interval 500ms
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# the app (login, feeds, rendered images) is not for search results — feedarte.com is
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	request_body {
		max_size 20MB
	}
	log {
		output stdout
		format console
		level WARN
	}
}

# ---------- landing page ----------
{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	root * /srv/landing
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@media path /img/* /help-media/* /og.png /apple-touch-icon.png /assets/*
	header @media Cache-Control "public, max-age=86400"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# /guides → /guides/ (one canonical URL per page)
	@noslash {
		not path */
		not path_regexp \.[A-Za-z0-9]+$
		file {path}/index.html
	}
	redir @noslash {path}/ 308
	try_files {path} {path}/index.html
	file_server
	# real 404 status for unknown URLs (no soft-404s in Google)
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
	log {
		output stdout
		format console
		level WARN
	}
}

www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
